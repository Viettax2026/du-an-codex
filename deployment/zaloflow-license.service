[Unit]
Description=ZaloFlow desktop license authority
After=network.target

[Service]
User=zaloflow-license
Group=zaloflow-license
WorkingDirectory=/opt/zaloflow
Environment=ZALOFLOW_LICENSE_DATA=/var/lib/zaloflow-licenses
Environment=ZALOFLOW_LICENSE_TRUST_PROXY=1
ExecStart=/opt/zaloflow/.venv/bin/gunicorn --bind 127.0.0.1:8010 --workers 2 --threads 2 --timeout 30 license_system.server:create_app()
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/zaloflow-licenses

[Install]
WantedBy=multi-user.target
